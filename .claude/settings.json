{
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "Bash(curl -s *)",
      "Bash(npx supabase migration list*)",
      "Bash(npm run lint*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git pull --quiet"
          }
        ]
      }
    ]
  }
}
