# Copy to .env.local for local development. On Vercel these are set under
# Project -> Settings -> Environment Variables. Values there are bound to a
# deployment at build time, so changing one needs a redeploy to take effect.
#
# Tip: `npx vercel env pull .env.local` downloads whatever is already set on
# Vercel instead of retyping it.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API. The anon key is public by design; every table is
# protected by owner-scoped RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely — server-side only, never in a 'use client' file.
# Currently unused (lib/supabase/admin.ts is scaffolding for future sync jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Contacts (People module) ------------------------------------
# console.cloud.google.com -> enable the People API -> OAuth consent screen
# (External, Testing, add yourself as a test user, scope contacts.readonly)
# -> Credentials -> OAuth client ID (Web application).
#
# Authorised redirect URIs must include every origin you actually use:
#   http://localhost:3000/api/google/callback
#   https://<your-production-domain>/api/google/callback
# While the consent screen is in "Testing", Google refresh tokens expire
# after 7 days (weekly re-auth); publishing the consent screen fixes that.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seals the Google refresh token at rest (AES-256-GCM). Any long random string
# works — it's hashed to 32 bytes — so a password manager can generate it.
# Changing it orphans the stored token; reconnect the integration to recover.
INTEGRATION_ENCRYPTION_KEY=

# --- Microsoft: OneNote (Education) + To Do (Todos page) -----------------
# One connection covers both: OneNote is read-only in-app browsing, To Do is
# a two-way sync of tasks (ticks, stars, edits, deletes).
# portal.azure.com -> App registrations -> New registration -> Supported
# account types: "Personal Microsoft accounts only" -> Authentication ->
# Add a platform -> Web -> redirect URI(s) below -> Certificates & secrets
# -> New client secret -> API permissions -> Microsoft Graph -> Delegated
# -> add Notes.Read, Tasks.ReadWrite, offline_access, openid, profile.
# After adding Tasks.ReadWrite, reconnect once (Todos page -> Connect) so
# the stored token includes it.
#
# Redirect URIs must include every origin you actually use:
#   http://localhost:3000/api/microsoft/callback
#   https://<your-production-domain>/api/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# The Alexa reminder skill also needs the delegated Calendars.ReadWrite
# permission (then reconnect once) — see docs/alexa-skill-setup.md.

# --- Alexa reminder skill ------------------------------------------------
# Private skill -> To Do task + Outlook event. Setup: docs/alexa-skill-setup.md
ALEXA_SKILL_ID=
ALEXA_ALLOWED_USER_ID=
ALEXA_OWNER_USER_ID=

# --- Supabase direct DB access -------------------------------------------
# Project Settings -> Database -> Connection string. Used for scripts/
# migrations that need a direct Postgres connection rather than the API.
SUPABASE_DB_URL=

# --- Starling (Money module) ---------------------------------------------
# developer.starlingbank.com -> personal access token, scoped read-only.
STARLING_ACCESS_TOKEN=

# (Apple Reminders via iCloud CalDAV was removed — iCloud doesn't expose
# upgraded Reminders lists over CalDAV. The ICLOUD_CALDAV_* vars are unused;
# delete them from .env.local and Vercel.)

# --- Gemini (People quick-add + home search) ------------------------------
# aistudio.google.com -> Get API key. Free tier — see lib/ai/gemini.ts for
# the swappable interface every AI call in this app goes through.
GEMINI_API_KEY=

# Optional kill switch — set to the literal string "false" to make every
# generateStructured() call throw immediately instead of hitting Gemini.
# Unset (or anything else) leaves AI features on.
AI_ENABLED=

# --- Bible module prompt launcher ------------------------------------------
# Optional deep-link for "Open Claude Project", a separate Claude Project you
# paste the copied prompt into. The Bible module never calls an AI API
# itself — leave unset to hide the link entirely.
NEXT_PUBLIC_BIBLE_CLAUDE_PROJECT_URL=
